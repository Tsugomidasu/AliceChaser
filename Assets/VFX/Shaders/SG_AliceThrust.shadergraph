{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "4a046a42da8340eb8a23f0379d5a3660",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "AliceThrustShape (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1080.0,
            "y": -100.0,
            "width": 0.0,
            "height": 0.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "c8930f505b694b9d9bc3bfc2138d2c26"
        },
        {
            "m_Id": "ba46868e0fe441fbb48c7c1a8b65412c"
        },
        {
            "m_Id": "f69cef64b53d4dc194e52ef55185dc6f"
        },
        {
            "m_Id": "362e77ce1002461aa95b8088fc3aefa3"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "AliceThrustShape",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "$precision x = UV.x;\n$precision y = UV.y - 0.5;\n\n// Keep the shape inside the sprite and give both ends a clean taper.\n$precision startMask = smoothstep(0.045, 0.090, x);\n$precision endMask = 1.0 - smoothstep(0.955, 0.975, x);\n$precision lengthMask = startMask * endMask;\n\n// Match the wider slash body while keeping the cyan outline thin.\n$precision edgeNoise = (Noise - 0.5) * 0.008;\n$precision feather = 0.005;\n\n// Main straight shaft. Full body thickness is about 0.10 before the tip taper.\n$precision tipT = saturate((x - 0.70) / 0.27);\n$precision shaftHalfWidth = lerp(0.050, 0.0025, tipT);\n$precision shaftEdge = max(shaftHalfWidth + edgeNoise, 0.0015);\n$precision shaftMask = 1.0 - smoothstep(shaftEdge, shaftEdge + feather, abs(y));\n\n// Short upper and lower prongs. They stay substantial but remain secondary to the shaft.\n$precision prongT = saturate((x - 0.67) / 0.30);\n$precision prongGate = smoothstep(0.655, 0.715, x) * endMask;\n$precision prongOffset = 0.170 * (1.0 - prongT);\n$precision prongHalfWidth = lerp(0.042, 0.0055, prongT);\n$precision prongEdge = max(prongHalfWidth + edgeNoise, 0.0015);\n\n$precision upperMask = 1.0 - smoothstep(prongEdge, prongEdge + feather, abs(y - prongOffset));\n$precision lowerMask = 1.0 - smoothstep(prongEdge, prongEdge + feather, abs(y + prongOffset));\nupperMask *= prongGate;\nlowerMask *= prongGate;\n\n// Union the three simple bands. No filled cone is added between them.\nBody = max(shaftMask, max(upperMask, lowerMask)) * lengthMask;\n\n// Keep approximately the same thin cyan border as the wider slash.\n$precision coreFeather = 0.005;\n$precision shaftOutline = lerp(0.009, 0.0010, tipT);\n$precision shaftCoreHalf = max(shaftHalfWidth - shaftOutline, 0.0006);\n$precision shaftCore = 1.0 - smoothstep(shaftCoreHalf, shaftCoreHalf + coreFeather, abs(y));\n\n$precision prongOutline = lerp(0.009, 0.0012, prongT);\n$precision prongCoreHalf = max(prongHalfWidth - prongOutline, 0.0006);\n$precision upperCore = 1.0 - smoothstep(prongCoreHalf, prongCoreHalf + coreFeather, abs(y - prongOffset));\n$precision lowerCore = 1.0 - smoothstep(prongCoreHalf, prongCoreHalf + coreFeather, abs(y + prongOffset));\nupperCore *= prongGate;\nlowerCore *= prongGate;\n\nCore = max(shaftCore, max(upperCore, lowerCore)) * Body;"
}

